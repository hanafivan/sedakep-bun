# Bun runtime
PORT=3000
DB_PATH=data/app.sqlite

# Auth
JWT_SECRET=dev-secret-ganti-di-produksi

# Basic Auth
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=admin
BASIC_AUTH_SALT=dev-salt-ganti-di-produksi
BASIC_AUTH_ITERATIONS=100000
# BASIC_AUTH_PASSWORD_HASH=<isi dengan output dari: bun run hash:basic-auth admin>

# MySQL adapter
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sedakep
MYSQL_CONNECTION_LIMIT=10

# MinIO / S3-compatible storage adapter
STORAGE_DRIVER=minio
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_BUCKET=sedakep-documents
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PRESIGN_TTL_SECONDS=900
# Fallback development only
STORAGE_LOCAL_ROOT=storage

# Basis URL untuk tautan verifikasi QR pada dokumen cetak (surat tugas, SK, SPHD)
PUBLIC_BASE_URL=http://localhost:3000
