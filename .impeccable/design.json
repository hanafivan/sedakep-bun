{
  "name": "Sedakep",
  "northStar": "Meja Kerja Kantor",
  "mode": "operate",
  "elevation": {
    "shadow": "0 1px 2px rgba(27, 42, 35, 0.06), 0 8px 24px -18px rgba(27, 42, 35, 0.35)",
    "philosophy": "garis lebih dulu, bayangan terakhir; shadow hanya untuk elemen terapung"
  },
  "motion": {
    "pageEnter": "rise 220ms cubic-bezier(0.16, 1, 0.3, 1)",
    "hover": "120ms ease-out",
    "reducedMotion": "animasi rute dimatikan, transisi ~0ms"
  },
  "breakpoints": {
    "md": "900px",
    "sm": "640px"
  },
  "browserSurfaces": {
    "selection": "rgba(14, 107, 60, 0.18)",
    "focusRing": "2px solid #0e6b3c (offset 2px)",
    "caret": "#0e6b3c",
    "scrollbar": "thin; thumb --line-2, track transparent"
  },
  "components": {
    "button-primary": {
      "html": "<button>Simpan</button>",
      "css": "padding:9px 15px;border-radius:9px;background:#0e6b3c;color:#fff;font-weight:600;border:0;"
    },
    "button-secondary": {
      "html": "<button class=\"secondary\">Batal</button>",
      "css": "background:#fffdf7;border:1px solid #cbc3ad;color:#1b2a23;border-radius:9px;padding:9px 15px;"
    },
    "input": {
      "html": "<input placeholder=\"Cari\">",
      "css": "width:100%;padding:9px 12px;border-radius:9px;border:1px solid #cbc3ad;background:#efeadd;color:#1b2a23;font:inherit;"
    },
    "panel": {
      "html": "<div class=\"panel\"><h2>Judul</h2></div>",
      "css": "background:#fffdf7;border:1px solid #e0d9c8;border-radius:12px;padding:20px;"
    },
    "nav-link": {
      "html": "<a class=\"nav-link active\">Permohonan</a>",
      "css": "display:flex;gap:10px;align-items:center;padding:8px 10px;border-radius:9px;color:#1b2a23;text-decoration:none;"
    },
    "badge": {
      "html": "<span class=\"badge ok\">Diterima</span>",
      "css": "display:inline-block;padding:3px 10px;border-radius:999px;font-size:11.5px;font-weight:600;"
    }
  },
  "rules": {
    "do": [
      "hijau hanya untuk aksi dan makna",
      "kedalaman lewat border 1px",
      "serif untuk judul dan angka besar",
      "angka selalu dari server"
    ],
    "dont": [
      "warna sebagai hiasan latar besar",
      "border + bayangan lebar bersamaan",
      "serif untuk paragraf isi",
      "menghitung saldo di klien"
    ]
  }
}
