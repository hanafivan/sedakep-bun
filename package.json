{
  "name": "codebase-hono",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch api/index.ts",
    "start": "bun run api/index.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "typecheck:web": "bunx tsc --noEmit -p web/tsconfig.json",
    "hash:basic-auth": "bun scripts/hash-basic-auth.ts",
    "storage:verify": "bun scripts/verify-storage.ts",
    "mysql:verify": "bun scripts/verify-mysql.ts",
    "web": "bun run --cwd web vite",
    "web:build": "bun run --cwd web vite build",
    "web:preview": "bun run --cwd web vite preview",
    "dev:all": "bun run dev & bun run web",
    "migrate": "bun run scripts/migrate.ts",
    "migrate:status": "bun run scripts/migrate.ts --status",
    "migrate:legacy": "bun run scripts/migrate-legacy.ts",
    "quota:rebuild": "bun run scripts/rebuild-quota.ts",
    "quota:reconcile": "bun run scripts/quota-reconcile.ts",
    "scheduler": "bun run scripts/scheduler.ts",
    "report:go-live": "bun run scripts/go-live-report.ts",
    "backup": "bun run scripts/backup.ts",
    "migrate:documents": "bun run scripts/migrate-documents.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "0.19.10",
    "@hono/zod-validator": "^0.4.1",
    "hono": "^4.6.0",
    "mysql2": "^3.24.5",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.6.0",
    "vite": "^8.3.3"
  }
}
